<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/InfoContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/info_container"
    android:padding="12dp">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toStartOf="@+id/button_delete_observation"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/textView_observation_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto da observação aqui"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_observation_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="25/06/2025 00:09"
            android:textColor="#555555"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/button_delete_observation"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_delete"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Apagar observação"
        android:clickable="true"
        android:focusable="true"/>
</RelativeLayout>
