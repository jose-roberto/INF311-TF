<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    style="@style/GeneralContainer">

    <LinearLayout
        android:id="@+id/userContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/section_container" >

        <ImageView
            android:id="@+id/profilePicture"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:id="@+id/profileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fulano Ciclano"
            android:layout_marginLeft="10dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:fontFamily="@font/inter_regular"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/historyInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/userContainer"
        android:layout_marginTop="14dp"
        android:background="@drawable/section_container"
        android:orientation="vertical">

        <TextView
            style="@style/TitleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_arrowright"
            android:drawablePadding="8dp"
            android:text="Informações do histórico"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            style="@style/InfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_container">

            <TextView
                android:id="@+id/userFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frequência: "
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/InfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_container">

            <TextView
                android:id="@+id/userGrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nota geral: "
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/InfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_container">

            <TextView
                android:id="@+id/userSatisfaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Satisfação: "
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/InfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_container">

            <TextView
                android:id="@+id/userSituation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Situação: "
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/certificateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/historyInfoContainer"
        android:layout_marginTop="16dp"
        android:background="@drawable/section_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coeficiente de rendimento"
            android:textStyle="bold"
            android:textSize="18sp"
            android:drawableEnd="@drawable/ic_dropdown"
            android:drawablePadding="8dp"
            style="@style/TitleContainer"/>
    </LinearLayout>
</RelativeLayout>