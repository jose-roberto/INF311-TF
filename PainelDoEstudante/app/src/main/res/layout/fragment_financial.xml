<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    style="@style/GeneralContainer">

    <LinearLayout
        android:id="@+id/userContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/section_container" >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePicture"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"/>

        <TextView
            android:id="@+id/profileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fulano Ciclano"
            android:layout_marginLeft="10dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:fontFamily="@font/inter_regular"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/paymentsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_below="@id/userContainer"
        android:background="@drawable/section_container">

        <TextView
            android:id="@+id/yearFilterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025"
            android:textStyle="bold"
            android:textSize="18sp"
            android:drawableEnd="@drawable/ic_dropdown"
            android:drawablePadding="8dp"
            style="@style/TitleContainer"
            android:padding="8dp"/>

        <LinearLayout
            android:id="@+id/paymentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/paymentsInfo"
        android:layout_marginTop="16dp"
        android:background="@drawable/section_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visão Geral"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_arrowright"
            android:drawablePadding="8dp"
            style="@style/TitleContainer"
            android:textSize="18sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textOpenPayments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="Mensalidades abertas"
                android:layout_marginRight="20dp"
                android:gravity="center"
                android:textSize="15sp"
                android:background="@drawable/info_container"
                android:textStyle="bold"
                style="@style/InfoContainer" />

            <TextView
                android:id="@+id/valueOpenPayments"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:drawablePadding="8dp"
                android:text="2"
                android:gravity="center"
                android:textSize="15sp"
                android:background="@drawable/info_container"
                android:textStyle="bold"
                style="@style/InfoContainer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textValuePayments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:layout_marginRight="20dp"
                android:text="Valor total em aberto"
                android:textSize="15sp"
                android:background="@drawable/info_container"
                android:textStyle="bold"
                style="@style/InfoContainer" />

            <TextView
                android:id="@+id/valueValuePayments"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:text="R$ 325,00"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:textSize="15sp"
                android:background="@drawable/info_container"
                android:textStyle="bold"
                style="@style/InfoContainer" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>