<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#72D8B5"
    android:id="@+id/homepage">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/logo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:text="Acompanhe seus estudantes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/title"
            android:layout_marginTop="24dp"
            android:background="@drawable/info_container"
            android:hint="Pesquise"
            android:textColorHint="@color/black"
            android:paddingStart="18dp"
            android:drawableStart="@drawable/ic_search"
            android:textColor="#000000"
            android:textSize="16sp" />


        <LinearLayout
            android:id="@+id/recentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/searchField"
            android:layout_marginTop="40dp"
            android:background="@drawable/section_container">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recentes"
                android:textStyle="bold"
                android:textSize="18sp"
                android:drawableStart="@drawable/ic_arrowright"
                android:drawablePadding="8dp"
                style="@style/TitleContainer"/>
        </LinearLayout>

    </RelativeLayout>
</ScrollView>
